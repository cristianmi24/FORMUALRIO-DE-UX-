rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // This claim must be assigned by a trusted server using the Firebase Admin SDK.
    function hasAdminAccess() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Survey responses collection
    match /survey_responses/{responseId} {
      // Survey responses contain personal and qualitative information.
      allow get, list: if hasAdminAccess();

      // Allow anonymous academic submissions with schema validation
      allow create: if isValidId(responseId)
        && request.resource.data.role in ['estudiante', 'docente', 'directivo']
        && request.resource.data.id is string
        && request.resource.data.submittedAt is string;

      // Only trusted administrators may delete records from the dashboard.
      allow delete: if hasAdminAccess() && isValidId(responseId);

      // Prevent in-place modifications to preserve historical integrity
      allow update: if false;
    }

    // Health / connection test collection
    match /test/{docId} {
      allow read: if true;
    }
  }
}
